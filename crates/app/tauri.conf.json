{
  "productName": "Good Idea Randomizer",
  "version": "0.1.0",
  "identifier": "xyz.mader.good-idea-randomizer",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Good Idea Randomizer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
